{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "web.fetch input",
  "type": "object",
  "required": ["url"],
  "properties": {
    "url":     { "type": "string", "format": "uri" },
    "method":  { "type": "string", "enum": ["GET", "HEAD"], "default": "GET" },
    "headers": { "type": "object", "additionalProperties": { "type": "string" } }
  }
}
