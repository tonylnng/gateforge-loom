# ============================================================
# Gateforge-Loom — environment template
# Copy to `.env` and fill in real values before `make up`.
# ============================================================

# ---- Postgres (Hermes long-term memory) ----
POSTGRES_USER=hermes
POSTGRES_PASSWORD=change_me_strong_password
POSTGRES_DB=hermes
POSTGRES_PORT=5432

# ---- Redis (state bus) ----
REDIS_PORT=6379
REDIS_PASSWORD=change_me_redis_password

# ---- Service ports (host-side) ----
CLAUDE_GATEWAY_PORT=8001
OPENCLAW_PORT=8002
HERMES_PORT=8003
N8N_PORT=5678

# ---- Inter-service auth (shared bearer for PoC; rotate per-service in prod) ----
INTERNAL_API_TOKEN=dev_internal_token_change_me

# ---- LLM provider keys (only needed when you swap stubs for real calls) ----
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
DEEPSEEK_API_KEY=

# Default Claude model id used by the gateway when stub mode is OFF
CLAUDE_MODEL=claude-sonnet-4-20250514

# ---- Stub toggle ----
# 1 = return canned JSON (no external API calls). 0 = call real providers.
STUB_MODE=1

# ---- n8n ----
N8N_BASIC_AUTH_ACTIVE=true
N8N_BASIC_AUTH_USER=admin
N8N_BASIC_AUTH_PASSWORD=change_me_n8n_password
N8N_HOST=localhost
N8N_ENCRYPTION_KEY=change_me_to_32_random_chars_xxx

# ---- Observability (optional) ----
LOG_LEVEL=INFO
